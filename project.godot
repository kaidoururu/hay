[application]
config_name="hay"
config_path=""
runnable=true

[display]
window_title="Hay Game"
window_resizable=true
window_vsync_mode=1

[rendering]
vsync=true
quality/high_quality=true
quality/anti_aliasing=1

[physics]
2d/default_process_mode=1
2d/contact_solver_iterations=10
2d/velocity_solver_iterations=10

[debug]
debug_collisions=false
debug_navigation=false

[audio]
driver=0
max_channels=32

[input]
default_deadzone=0.1

[autoload]

[import]
# Отключаем импорт Blender
blender_import/enabled=false

# Настройки импорта текстур
texture_import/compress/bptc=false
texture_import/compress/etc=false
texture_import/compress/etc2=false
texture_import/compress/pvrtc=false
texture_import/compress/s3tc=false

# Настройки импорта FBX
fbx_import/animations/enabled=true
fbx_import/animations/fps=30

# Настройки импорта OBJ
obj_import/materials/enabled=true

[editor_plugins]

[general]
script_encoding=UTF-8

[physics_2d]

[physics_3d]

[network]

[localization]

[modules]

[scene]

[gui]

[video_driver]

[audio_driver]

